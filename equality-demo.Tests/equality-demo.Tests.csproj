<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 本项目测的就是 Equals/== 语义本身：xUnit2010（建议改用 Assert.Equal）与
         CA2013（装箱调用 ReferenceEquals）都是测试对象，在此属误报 -->
    <NoWarn>$(NoWarn);xUnit2010;CA2013</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\equality-demo\equality-demo.csproj" />
    <ProjectReference Include="..\EqualityOverride\EqualityOverride.csproj" />
  </ItemGroup>

</Project>
